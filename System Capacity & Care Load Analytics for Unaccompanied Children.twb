        <zone forceUpdate='true' h='12469' id='9' type-v2='text' w='99868' x='0' y='0'>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontname='Arial' fontsize='13'>SYSTEM CAPACITY &amp; CARE LOAD ANALYTICS</run>
            <run fontalignment='1'>Æ&#10;</run>
