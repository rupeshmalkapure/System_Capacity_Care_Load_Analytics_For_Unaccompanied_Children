      <aliases enabled='yes' />
      <column caption='14 Day Avg' datatype='real' name='[14_day_avg]' role='measure' type='quantitative' />
      <column caption='7 Day Avg' datatype='real' name='[7_day_avg]' role='measure' type='quantitative' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.05b6igu1ww6exd15fyd7y0i3mpb3].[sum:14_day_avg:qk]&quot;' value='14 Day ' />
          <alias key='&quot;[federated.05b6igu1ww6exd15fyd7y0i3mpb3].[sum:7_day_avg:qk]&quot;' value='7 Day ' />
        </aliases>
      </column>
      <column datatype='real' name='[Accumulation rate]' role='measure' type='quantitative' />
      <column datatype='boolean' name='[Backlog indicator]' role='dimension' type='nominal'>
        <aliases>
          <alias key='false' value='No Pressure' />
          <alias key='true' value='Backlog Pressure' />
        </aliases>
      </column>
      <column caption='Selected Date Granularity' datatype='datetime' name='[Calculation_1621014431021608960]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &quot;Day&quot; THEN DATETRUNC(&apos;day&apos;,[Date])&#13;&#10;WHEN &quot;Week&quot; THEN DATETRUNC(&apos;week&apos;,[Date])&#13;&#10;WHEN &quot;Month&quot; THEN DATETRUNC(&apos;month&apos;,[Date])&#13;&#10;END' />
      </column>
      <column caption='Latest total childeren in care' datatype='real' name='[Calculation_1649724878885998594]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Date] = { FIXED : MAX([Date]) }&#13;&#10;THEN [Calculation_1781173691588251648]&#13;&#10;END' />
      </column>
      <column caption='Backlog' datatype='real' name='[Calculation_1649724878892109827]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [Net daily intake] &gt; 0 THEN 1&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNT([Net daily intake])&#13;&#10;* 100' />
      </column>
      <column caption='Total children in care' datatype='real' name='[Calculation_1781173691588251648]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Children in CBP custody]) + ([Children in HHS Care])' />
      </column>
      <column caption='Calculation1' datatype='real' name='[Calculation_1781173691598225409]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Children transferred out of CBP custody])-SUM([Children discharged from HHS Care])' />
      </column>
      <column caption='care load index' datatype='real' name='[Calculation_1781173691893682178]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='STDEVP([system load])' />
      </column>
      <column caption='Discharge offset ratio' datatype='real' name='[Calculation_1781173691942850563]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Children discharged from HHS Care])/SUM([Children transferred out of CBP custody]))*100' />
      </column>
      <column caption='DISCHARGE OFFSET RATIO' datatype='real' name='[Calculation_439382487148548096]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Children discharged from HHS Care])&#13;&#10;/&#13;&#10;SUM([Children transferred out of CBP custody])&#13;&#10;* 100' />
      </column>
      <column datatype='real' name='[Children apprehended and placed in CBP custody*]' role='measure' type='quantitative' />
      <column datatype='real' name='[Children discharged from HHS Care]' role='measure' type='quantitative' />
